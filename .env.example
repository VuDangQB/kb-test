# Copy to .env and fill in. The code reads plain environment variables
# (no dotenv loader), so export them first: `set -a; source .env; set +a`.

# --- Anthropic (read by the anthropic SDK in pipeline/llm.py) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Model (pipeline/config.py) ---
CLAUDE_MODEL=claude-sonnet-5-5

# Effort per node: low | medium | high
EFFORT_EXTRACT=medium
EFFORT_DECISION=medium
EFFORT_WRITE=medium

# adaptive | between_tools (between_tools only at low/medium/high effort)
CLAUDE_THINKING=adaptive

# --- Decision model ---
# claude | jev. If unset: "jev" when TYPESAFE_API_KEY is set, otherwise "claude".
DECISION_BACKEND=claude

# Required only for DECISION_BACKEND=jev. JevBackend is not wired yet
# (raises NotImplementedError), so leave this unset for now.
# TYPESAFE_API_KEY=

# Results whose priority or impact probability is below this get the "low_confidence" flag.
LOW_CONFIDENCE=0.6

# --- Eval (eval/run_one.py) ---
# KB's workbook for KB-n / KB-VD case IDs.
# KB_XLSX=/mnt/c/Users/VuDang/Downloads/KB Test Template for AI News Article Evaluation_2026.10.20.xlsx

# --- Tracing (pipeline/tracing.py, only with --phoenix) ---
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=kb-news-eval
